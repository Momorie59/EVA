# Copie ce fichier en .env et adapte les valeurs à ton réseau

# Adresse du serveur IA (Xeon + GTX 1060) où tourne Ollama
OLLAMA_HOST=http://192.168.1.50:11434

# Modèle à utiliser — doit déjà être pull sur le serveur IA (ollama pull ...)
OLLAMA_MODEL=qwen2.5:7b
# Petit modèle pour les réponses rapides (salutations, phrases courtes) ; vide = toujours le modèle principal
EVA_MODELE_RAPIDE=llama3.2:3b

# Modèle multimodal pour les messages avec photo (caméra) — différent du
# modèle principal, qui ne gère pas forcément les images. Doit aussi être
# pull sur le serveur IA (ex: ollama pull llava)
EVA_VISION_MODEL=llava

# Origines autorisées à se connecter en WebSocket/API (séparées par des virgules)
# Mets l'URL réelle de l'interface EVA une fois déployée, ex:
# CORS_ORIGINS=http://192.168.1.40:5173,https://eva.maison.local
CORS_ORIGINS=*

# Dossier où EVA lit/écrit (outils filesystem, project_docs, git)
EVA_WORKSPACE=./workspace

# Connexion Postgres (mémoire persistante)
DATABASE_URL=postgresql://eva:eva@localhost:5432/eva

# Nombre de messages rechargés à la reconnexion
EVA_HISTORY_LIMIT=30

# Jeton partagé protégeant le WebSocket et les endpoints REST (vide = pas d'auth)
EVA_AUTH_TOKEN=

# Ville par défaut pour le widget météo
EVA_DEFAULT_CITY=Paris

# Prénom de la personne à qui appartient EVA (« l'assistante d'Amélie ») ; vide = « de la famille »
EVA_PROPRIETAIRE=

# Seuils du monitor system_threshold (pourcentage, alerte au-dessus, puis
# notification quand ça revient en dessous)
EVA_CPU_THRESHOLD=90
EVA_MEMORY_THRESHOLD=90
EVA_DISK_THRESHOLD=90
