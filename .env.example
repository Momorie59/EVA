# Copie ce fichier en .env à la racine (à côté de docker-compose.yml)

# --- Serveur IA (Ollama) ---
OLLAMA_HOST=http://192.168.1.50:11434
OLLAMA_MODEL=qwen2.5:7b
# Petit modèle pour les réponses rapides (salutations, phrases courtes) ; vide = toujours le modèle principal
EVA_MODELE_RAPIDE=llama3.2:3b

# Modèle multimodal pour les photos (caméra) — ex: ollama pull llava
EVA_VISION_MODEL=llava

# --- Base de données ---
POSTGRES_USER=eva
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=eva

# --- Réseau ---
# Origines autorisées à se connecter à EVA CORE
CORS_ORIGINS=*
# IP (ou nom) du NAS tel que tapé dans le navigateur. Caddy génère un
# certificat HTTPS auto-signé pour cette adresse (requis pour micro/caméra).
EVA_HOST=192.168.1.40
# Port HTTPS d'EVA. NE PAS utiliser 80/443 : ils sont pris par OpenMediaVault.
EVA_HTTPS_PORT=8443
# Optionnel, uniquement si tu n'utilises pas Caddy (déconseillé : micro et caméra exigent HTTPS) :
# EVA_PUBLIC_WS_URL=ws://192.168.1.40:8000/ws/chat
# EVA_PUBLIC_CORE_URL=http://192.168.1.40:8000
# EVA_PUBLIC_VOICE_URL=http://192.168.1.40:8100

# Ville par défaut pour le widget météo
EVA_DEFAULT_CITY=Paris

# Prénom de la personne à qui appartient EVA (« l'assistante d'Amélie ») ; vide = « de la famille »
EVA_PROPRIETAIRE=

# Fuseau horaire des agents planifiés
EVA_TIMEZONE=Europe/Paris

# Modèle d'embeddings pour la recherche dans les documents (sur le serveur IA :
# ollama pull nomic-embed-text)
EVA_EMBED_MODEL=nomic-embed-text

# Estimation énergie / coût (page Traces) : puissance moyenne du GPU en watts
# et prix de l'électricité en € par kWh. Ordres de grandeur, pas des mesures.
EVA_GPU_WATTS=200
EVA_KWH_PRICE=0.25

# Seuils du monitor system_threshold (pourcentage, alerte au-dessus)
EVA_CPU_THRESHOLD=90
EVA_MEMORY_THRESHOLD=90
EVA_DISK_THRESHOLD=90

# --- Voix (eva-voice) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICE=fr_FR-siwis-medium
# Langues : « auto » = EVA comprend la langue parlée (une centaine) ; « fr » pour forcer le français
WHISPER_LANGUAGE=auto
# Langue par défaut (mot d'éveil, phrases trop courtes pour deviner)
EVA_LANGUE=fr
# Voix des autres langues téléchargées automatiquement la première fois (1) ou jamais (0)
PIPER_AUTO_DOWNLOAD=1
# Voix imposée pour une langue (facultatif) : PIPER_VOICE_IT=it_IT-paola-medium, PIPER_VOICE_EN=en_US-lessac-medium…

# --- Sécurité ---
# Jeton partagé protégeant le WebSocket d'EVA CORE et les endpoints d'EVA VOICE.
# Laisse vide en dev local ; À DÉFINIR avant toute exposition hors réseau local.
EVA_AUTH_TOKEN=

# --- Serveur d'images (eva-imagegen, sur le serveur IA) ---
# Laisse vide : EVA le détecte (Paramètres › Génération d'images › Détecter le serveur) ; le jeton affiché
# par install-imagegen.sh se colle dans l'interface, pas ici.
EVA_IMAGEGEN_URL=
# Compte Hugging Face (seulement pour les modèles qui demandent d'accepter une licence)
HF_TOKEN=

# --- Papiers (facultatif, voir PAPIERS.md) — tout se règle aussi dans la page Papiers d'EVA ---
# Paperless-ngx : adresse vue depuis EVA, adresse pour tes liens, jeton API
EVA_PAPERLESS_URL=
EVA_PAPERLESS_PUBLIC_URL=
EVA_PAPERLESS_TOKEN=
# Dossier du NAS visible par EVA (les dossiers surveillés se choisissent dedans) et dossiers surveillés (relatifs, séparés par des virgules)
EVA_PAPIERS_RACINE_NAS=/home/eva
EVA_PAPIERS_DOSSIERS=
# Heure du point « papiers » du matin
EVA_PAPIERS_HEURE=8

# --- Détection des appareils de la maison (eva-scanner, réseau hôte) ---
# Jeton partagé entre eva-core et eva-scanner : génère-le avec `openssl rand -hex 24`
EVA_SCANNER_TOKEN=

# --- AirLLM (secours quand le serveur IA est éteint, lent) ---
AIRLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Sécurité (NIS2) ---
# Longueur minimale des NOUVEAUX mots de passe (12 par défaut, 8 minimum)
EVA_MIN_PASSWORD=12
# Durée de conservation du journal d'accès, en jours (365 par défaut)
EVA_AUDIT_DAYS=365
