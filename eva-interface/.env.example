# Copie en .env.local — en général RIEN à régler : l'interface utilise la même
# origine que la page (via Caddy en prod, via le proxy Vite en dev).
# Surcharges optionnelles (seulement si tu n'utilises pas Caddy) :
# VITE_EVA_WS_URL=ws://192.168.1.40:8000/ws/chat
# VITE_EVA_CORE_URL=http://192.168.1.40:8000
# VITE_EVA_VOICE_URL=http://192.168.1.40:8100

# Jeton d'authentification — doit correspondre à EVA_AUTH_TOKEN côté backend.
VITE_EVA_AUTH_TOKEN=
